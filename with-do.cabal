cabal-version: 3.4

name:           with-do
version:        0.1.0.0
category:       Control
synopsis:       QualifiedDo for Koka-style with statements
description:    Please see the README on GitHub at <https://github.com/wasabi315/with-do#readme>
homepage:       https://github.com/wasabi315/with-do#readme
bug-reports:    https://github.com/wasabi315/with-do/issues
author:         Satoshi Takimoto
maintainer:     wasabi.nvim.st@gmail.com
copyright:      2026 Satoshi Takimoto
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
extra-doc-files:
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/wasabi315/with-do

library
  exposed-modules:
    With
    With.Internal
  hs-source-dirs: src
  build-depends: base >=4.15 && <5
  default-language: Haskell2010

executable with-do-example
  hs-source-dirs: example
  main-is: Main.hs
  default-language: Haskell2010
  build-depends:
    , base >= 4.15 && <5
    , with-do

test-suite with-do-inspect
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  default-language: Haskell2010
  build-depends:
    , base >= 4.15 && <5
    , inspection-testing
    , with-do
